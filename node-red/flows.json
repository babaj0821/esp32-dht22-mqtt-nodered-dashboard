        "z": "44d1050f64446152",
        "name": "function 1",
        "func": "let parts = msg.topic.split(\"/\");\nlet deviceId = parts[2];\n\nlet data = msg.payload.split(\",\");\n\nlet temperature = parseFloat(data[0]);\nlet humidity = parseFloat(data[1]);\n\nlet msgTemp = {\n    topic: deviceId,\n    payload: temperature\n};\n\nlet msgHum = {\n    topic: deviceId,\n    payload: humidity\n};\n\nreturn [msgTemp, msgHum];",
